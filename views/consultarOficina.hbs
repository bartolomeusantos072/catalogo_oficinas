<h1 class="mb-3">Consulta de Oficina</h1>

<p class="mb-2"><strong>ID</strong><br>{{oficina.id}}</p>
<p class="mb-2"><strong>Título</strong><br>{{oficina.titulo}}</p>
<p class="mb-2"><strong>Responsável</strong><br>{{oficina.responsavel}}</p>
<p class="mb-2"><strong>Carga horária total</strong><br>{{oficina.carga_horaria}} h</p>
<p class="mb-2"><strong>Inscrições</strong><br>{{#if oficina.inscricoesAbertas}}Abertas{{else}}Encerradas{{/if}}</p>
<p class="mb-1"><strong>Descrição</strong></p>
<pre>{{oficina.descricao}}</pre>

<a href="/oficinas/altera/{{oficina.id}}" class="btn btn-primary mt-3">Editar</a>