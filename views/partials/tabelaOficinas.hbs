{{#if temOficinas}}
  {{#if mostraAbertasApenas}}
    {{#unless temAbertas}}
      <p>Nenhuma oficina está com inscrições abertas.</p>
    {{/unless}}
  {{/if}}

  {{#if oficinas.length}}
  <table class="table table-hover align-middle">
    <thead class="table-primary text-center">
      <tr>
        <th>Título</th>
        <th>Carga horária</th>
        <th>Inscrições</th>
        <th>Ações</th>
      </tr>
    </thead>
    <tbody>
      {{#each oficinas}}
      <tr>
        <td class="fw-bold">{{this.titulo}}</td>
        <td class="text-center">{{this.carga_horaria}} h</td>
        <td class="text-center">{{#if this.inscricoesAbertas}}Abertas{{else}}Encerradas{{/if}}</td>
        <td class="text-center">
          <a href="/oficinas/consulta/{{this.id}}" class="btn btn-primary btn-sm">Consultar</a>
          <a href="/oficinas/altera/{{this.id}}" class="btn btn-primary btn-sm">Editar</a>
          <button type="button" class="btn btn-danger btn-sm" data-bs-toggle="modal" data-bs-target="#modalExcluir{{this.id}}">Excluir</button>
          <a href="/oficinas/alterna/{{this.id}}" class="btn btn-outline-primary btn-sm">{{#if this.inscricoesAbertas}}Encerrar{{else}}Reabrir{{/if}}</a>
        </td>
      </tr>
      {{/each}}
    </tbody>
  </table>

  {{#each oficinas}}
  <div class="modal fade" id="modalExcluir{{this.id}}" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
      <div class="modal-content">
        <div class="modal-header">
          <h5 class="modal-title">Excluir oficina</h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fechar"></button>
        </div>
        <div class="modal-body">
          Confirma a exclusão de <strong>{{this.titulo}}</strong>?
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
          <a href="/oficinas/deleta/{{this.id}}" class="btn btn-danger">Confirmar</a>
        </div>
      </div>
    </div>
  </div>
  {{/each}}
  {{/if}}
{{else}}
  <p>Nenhuma oficina cadastrada.</p>
  <a href="/oficinas/cria" class="btn btn-primary">Cadastrar a primeira oficina</a>
{{/if}}