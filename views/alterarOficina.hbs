<h2 class="mb-3">Editar Oficina</h2>
<form action="/oficinas/altera/{{oficina.id}}" method="POST" class="bg-white p-4 shadow-sm rounded">
  <div class="mb-3">
    <label for="titulo" class="form-label">Título</label>
    <input type="text" class="form-control" id="titulo" name="titulo" value="{{oficina.titulo}}" required>
  </div>
  <div class="mb-3">
    <label for="responsavel" class="form-label">Responsável</label>
    <input type="text" class="form-control" id="responsavel" name="responsavel" value="{{oficina.responsavel}}" required>
  </div>
  <div class="mb-3">
    <label for="descricao" class="form-label">Descrição</label>
    <textarea class="form-control" id="descricao" name="descricao" rows="5" required>{{oficina.descricao}}</textarea>
  </div>
  <div class="mb-3">
    <label for="carga_horaria" class="form-label">Carga horária total (em horas)</label>
    <input type="number" class="form-control" id="carga_horaria" name="carga_horaria" min="1" max="40" value="{{oficina.carga_horaria}}" required>
  </div>
  <button type="submit" class="btn btn-primary">Salvar</button>
  <a href="/oficinas/consulta/{{oficina.id}}" class="btn btn-secondary">Cancelar</a>
</form>