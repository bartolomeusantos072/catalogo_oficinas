<h1 class="mb-3">Oficinas cadastradas</h1>

<p class="mb-3">
  Total de oficinas: <strong>{{indicadores.total}}</strong>
  <span class="ms-2">Abertas: <strong>{{indicadores.abertas}}</strong></span>
  <span class="ms-2">Encerradas: <strong>{{indicadores.encerradas}}</strong></span>
  <span class="ms-2">Carga horária das abertas: <strong>{{indicadores.cargaHorariaAbertas}} h</strong></span>
</p>

<div class="mb-3">
  {{#if mostraAbertasApenas}}
    <a href="/oficinas" class="btn btn-link">Todas as Oficinas</a>
    <a href="/oficinas/abertas" class="btn btn-primary">Inscrições Abertas</a>
  {{else}}
    <a href="/oficinas" class="btn btn-primary">Todas as Oficinas</a>
    <a href="/oficinas/abertas" class="btn btn-link">Inscrições Abertas</a>
  {{/if}}
</div>

{{#if temOficinas}}
  {{#if mostraAbertasApenas}}
    {{#unless temAbertas}}
      <div class="alert alert-warning">Nenhuma oficina está com inscrições abertas.</div>
    {{else}}
      {{> tabelaOficinas}}
    {{/unless}}
  {{else}}
    {{> tabelaOficinas}}
  {{/if}}
{{else}}
  <p>Nenhuma oficina cadastrada.</p>
  <a href="/oficinas/cria" class="btn btn-primary">Cadastrar a primeira oficina</a>
{{/if}}