<h2 class="mb-3">Oficinas cadastradas</h2>

<p class="text-muted mb-3">
  Total de oficinas: <strong>{{indicadores.total}}</strong> | 
  Abertas: <strong>{{indicadores.abertas}}</strong> | 
  Encerradas: <strong>{{indicadores.encerradas}}</strong> | 
  Carga horária das abertas: <strong>{{indicadores.cargaHorariaAbertas}} h</strong>
</p>

<div class="mb-3">
  {{#if mostraAbertasApenas}}
    <a href="/oficinas" class="btn btn-outline-primary">Todas as Oficinas</a>
    <a href="/oficinas/abertas" class="btn btn-primary">Inscrições Abertas</a>
  {{else}}
    <a href="/oficinas" class="btn btn-primary">Todas as Oficinas</a>
    <a href="/oficinas/abertas" class="btn btn-outline-primary">Inscrições Abertas</a>
  {{/if}}
</div>

{{#if temOficinas}}
  {{#if mostraAbertasApenas}}
    {{#unless temAbertas}}
      <div class="alert alert-warning">Nenhuma oficina está com inscrições abertas.</div>
    {{else}}
      {{> tabelaOficinas}}
    {{/unless}}
  {{else}}
    {{> tabelaOficinas}}
  {{/if}}
{{else}}
  <div class="alert alert-info">
    Nenhuma oficina cadastrada. <a href="/oficinas/cria" class="btn btn-primary">Cadastrar a primeira oficina</a>.
  </div>
{{/if}}

<!-- Partial ou bloco da Tabela -->
{{#if oficinas}}
<table class="table table-hover align-middle bg-white shadow-sm rounded">
  <thead class="table-primary text-center">
    <tr>
      <th>Título</th>
      <th>Carga horária</th>
      <th>Inscrições</th>
      <th>Ações</th>
    </tr>
  </thead>
  <tbody>
    {{#each oficinas}}
    <tr>
      <td>{{this.titulo}}</td>
      <td class="text-center">{{this.carga_horaria}} h</td>
      <td class="text-center">
        {{#if this.inscricoesAbertas}}Abertas{{else}}Encerradas{{/if}}
      </td>
      <td class="text-center">
        <a href="/oficinas/consulta/{{this.id}}" class="btn btn-primary btn-sm">Consultar</a>
        <a href="/oficinas/altera/{{this.id}}" class="btn btn-primary btn-sm">Editar</a>
        <button type="button" class="btn btn-danger btn-sm" data-bs-toggle="modal" data-bs-target="#modalExcluir{{this.id}}">Excluir</button>
        
        {{#if this.inscricoesAbertas}}
          <a href="/oficinas/alterna/{{this.id}}" class="btn btn-outline-secondary btn-sm">Encerrar</a>
        {{else}}
          <a href="/oficinas/alterna/{{this.id}}" class="btn btn-outline-secondary btn-sm">Reabrir</a>
        {{/if}}
      </td>
    </tr>

    <!-- Modal de Confirmação de Exclusão Bootstrap -->
    <div class="modal fade" id="modalExcluir{{this.id}}" tabindex="-1" aria-hidden="true">
      <div class="modal-dialog">
        <div class="modal-content">
          <div class="modal-header">
            <h5 class="modal-title">Excluir oficina</h5>
            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
          </div>
          <div class="modal-body">
            Confirma a exclusão de <strong>{{this.titulo}}</strong>?
          </div>
          <div class="modal-footer">
            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
            <a href="/oficinas/deleta/{{this.id}}" class="btn btn-danger">Confirmar</a>
          </div>
        </div>
      </div>
    </div>
    {{/each}}
  </tbody>
</table>
{{/if}}