<h1 class="mb-3">Pesquisa de Oficinas</h1>

<form action="/oficinas/pesquisa" method="POST" class="mb-3">
  <div class="mb-3">
    <label for="termo" class="form-label">Título da oficina</label>
    <input type="text" class="form-control" id="termo" name="termo" value="{{termo}}" required>
  </div>
  <button type="submit" class="btn btn-primary">Pesquisar</button>
</form>

{{#if pesquisado}}
  {{#if temResultado}}
    <ul>
      {{#each resultado}}
        <li><a href="/oficinas/consulta/{{this.id}}">{{this.titulo}}</a></li>
      {{/each}}
    </ul>
  {{else}}
    <p>Nenhuma oficina encontrada com o termo "{{termo}}".</p>
  {{/if}}
{{else}}
  <p>Digite um termo para pesquisar pelo título da oficina.</p>
{{/if}}